# Values this project expects in the docker-jitsi-meet .env (everything else: Jitsi defaults)
PUBLIC_URL=https://meet.example.org
ENABLE_AUTH=1
ENABLE_GUESTS=1
AUTH_TYPE=jwt
JWT_APP_ID=tfs
JWT_ACCEPTED_ISSUERS=tfs
JWT_ACCEPTED_AUDIENCES=tfs
JWT_APP_SECRET=CHANGE_ME_SAME_AS_jwt.json
ENABLE_LOBBY=1
ENABLE_RECORDING=1
JIBRI_RECORDING_DIR=/config/recordings
XMPP_MUC_MODULES=muc_max_occupants,tfs_time_limit,tfs_autorecord,tfs_state
JVB_ADVERTISE_IPS=YOUR_SERVER_IP
